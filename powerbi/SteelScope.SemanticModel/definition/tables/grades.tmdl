		annotation SummarizationSetBy = User

	column has_measured_strength
		dataType: boolean
		lineageTag: 44d38603-54b0-50c9-b3d9-619bf55d1aab
		summarizeBy: none
		sourceColumn: has_measured_strength

		annotation SummarizationSetBy = User

	column strength_class
		dataType: string
		lineageTag: 6caa7c89-4168-5643-92f6-350fb53b0f72
		summarizeBy: none
		sourceColumn: strength_class
		sortByColumn: strength_class_order

		annotation SummarizationSetBy = User

	column strength_class_order
		dataType: int64
		isHidden
		lineageTag: 5d64ee19-12c2-54cf-8767-ccf8e7b73bde
		summarizeBy: none
		sourceColumn: strength_class_order

		annotation SummarizationSetBy = User

	column liquidus_c
		dataType: double
