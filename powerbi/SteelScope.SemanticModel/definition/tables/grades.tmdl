table grades
	lineageTag: 951ebea4-1064-5a06-a77e-a10dd9ebee49

	measure Grades = COUNTROWS ( grades )
		formatString: #,0
		lineageTag: 8749689a-a8bc-5584-8557-113c1d393a83

	measure 'Measured grades' = CALCULATE ( [Grades], grades[has_measured_strength] = TRUE () )
		formatString: #,0
		lineageTag: 948217b0-6e34-51c1-b1e7-c138c3aa55b8

	measure 'Median strength (MPa)' = MEDIAN ( grades[tensile_strength_mpa] )
		formatString: #,0
		lineageTag: 63edb523-a292-5d13-b724-955cd84117c3

	measure 'Mean strength (MPa)' = AVERAGE ( grades[tensile_strength_mpa] )
		formatString: #,0.0
		lineageTag: 65db22f2-d136-56a9-8284-002150bd1f80

	measure 'Q1 strength (MPa)' =
			PERCENTILEX.INC (
			    FILTER ( grades, NOT ISBLANK ( grades[tensile_strength_mpa] ) ),
			    grades[tensile_strength_mpa],
			    0.25
			)
		formatString: #,0
		lineageTag: d678576e-80f5-583e-b686-681bb106d6d5

	measure 'Q3 strength (MPa)' =
			PERCENTILEX.INC (
			    FILTER ( grades, NOT ISBLANK ( grades[tensile_strength_mpa] ) ),
			    grades[tensile_strength_mpa],
			    0.75
			)
		formatString: #,0
		lineageTag: cc6db3ee-c5a9-5bae-88aa-17a0752201c6

	measure 'Middle 50 % (MPa)' = FORMAT ( [Q1 strength (MPa)], "0" ) & "–" & FORMAT ( [Q3 strength (MPa)], "0" )
		lineageTag: b63551ec-2e8d-5e5e-bbaa-a3c94cb43686

	measure 'Median carbon equivalent' = MEDIAN ( grades[carbon_equivalent] )
		formatString: 0.00
		lineageTag: 9cb96711-0ed8-5f41-b936-0cfa112e14b6

	measure 'Share of grades' = DIVIDE ( [Grades], CALCULATE ( [Grades], ALLSELECTED ( grades ) ) )
		formatString: 0.0%
		lineageTag: cf397e01-0d88-5d4f-acee-cb0403ce883f

	measure 'High-strength share' =
			DIVIDE (
			    CALCULATE ( [Measured grades], grades[strength_class_order] = 2 ),
			    [Measured grades]
			)
		formatString: 0.0%
		lineageTag: a4c6a3db-9c99-5fec-a53e-408d17a383ec

	measure 'Readily weldable share (plain steels)' =
			DIVIDE (
			    CALCULATE ( [Grades], grades[weldability_band] = "Readily weldable (CE <= 0.40)" ),
			    CALCULATE ( [Grades], grades[weldability_band] <> "Not applicable" )
			)
		formatString: 0.0%
		lineageTag: d415eca0-a62b-54a3-911c-dd626447e8c2

	measure 'Average wt %' = DIVIDE ( SUM ( composition[wt_pct] ), [Grades] )
		formatString: 0.000
		lineageTag: b2afab71-bb9c-5ed4-9646-76663d5f9acb

	measure 'Element intensity' =
			DIVIDE (
			    [Average wt %],
			    MAXX ( ALL ( families[family_group], families[group_order] ), [Average wt %] )
			)
		formatString: 0%
		lineageTag: 2b547552-63fd-5059-aaf7-0392a8e774ca

	measure 'Heatmap colour' =
			VAR t = [Element intensity]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( t ), BLANK (),
			        t >= 0.8, "#4a8fdc",
			        t >= 0.6, "#7aaee6",
			        t >= 0.4, "#a6c8ef",
			        t >= 0.2, "#cde2fb",
			        "#f7fafe"
			    )
		lineageTag: 16f64e38-d3ec-53dc-bd34-bad399dc43e4

	measure 'Placeholder liquidus grades' = CALCULATE ( [Grades], grades[liquidus_is_placeholder] = TRUE () )
		formatString: #,0
		lineageTag: edf6394e-e78a-5e3d-9ab3-0540d91559f6

	column grade_id
