{
  "name": "SteelScope",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "background": "#FFFFFF",
  "foreground": "#1F1F1F",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#104281",
  "center": "#f0efec",
  "minimum": "#cde2fb",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#104281" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F1F1F" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F1F1F" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A4A4A" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E1DC" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 8, "bottom": 8, "left": 12, "right": 12 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F1F1F" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "subTitle": [{ "fontColor": { "solid": { "color": "#6B6B6B" } }, "fontSize": 9 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F3F0" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F3F0" } }, "transparency": 0 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "padding": [{ "top": 0, "bottom": 0, "left": 4, "right": 4 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#104281" } }, "fontSize": 22 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#6B6B6B" } }, "fontSize": 10 }]
      }
    }
  }
}
