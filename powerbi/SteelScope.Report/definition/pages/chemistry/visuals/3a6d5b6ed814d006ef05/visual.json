    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read the map",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F1F1F",
                      "fontFamily": "Segoe UI Semibold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each dot is one grade, placed by its composition: grades close together are chemically alike. The two axes are the first two principal components of the log-scaled, standardised composition (20 elements and a trace total).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4A4A4A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "PC1 is driven by chromium and nickel, so stainless grades stretch to the right. PC2 follows tungsten, vanadium, molybdenum and cobalt, lifting tool and high-speed steels. Cast irons separate on carbon and silicon.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4A4A4A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The heatmap above confirms it: Cr and Ni light up for stainless, W, V, Mo and Co for tool steels, C and Si for cast iron.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4A4A4A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
