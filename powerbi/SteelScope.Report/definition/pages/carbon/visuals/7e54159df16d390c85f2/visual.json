                      "fontSize": "10pt",
                      "color": "#4A4A4A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "More carbon also raises the carbon equivalent, so the strongest plain steels are the hardest to weld.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4A4A4A",
                      "fontFamily": "Segoe UI"
                    }
                  }
