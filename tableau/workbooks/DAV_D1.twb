      <aliases enabled='yes' />
      <column caption='Measure TS' datatype='real' name='[Calculation_1244979895422976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT [is_imputed_ts] THEN [tensile_strength_mpa] END' />
      </column>
      <column caption='Liquidous' datatype='string' name='[Calculation_1244979895595009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [liquidus_is_default] THEN &quot;Default 1460 °C&quot; ELSE &quot;Grade-specific&quot; END' />
      </column>
      <column caption='Carbon band' datatype='string' name='[Calculation_1244979895676930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [C] &lt;= 0.25 THEN &quot;1 Low carbon (≤0.25)&quot; ELSEIF [C] &lt;= 0.60 THEN &quot;2 Medium carbon (0.25–0.60)&quot; ELSEIF [C] &lt;= 2.1 THEN &quot;3 High carbon / tool (0.60–2.1)&quot; ELSE &quot;4 Cast-iron range (&gt;2.1)&quot; END' />
      </column>
      <column caption='Alloy band' datatype='string' name='[Calculation_1244979895746563]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [alloying_total] &lt; 5 THEN &quot;1 Lean (&lt;5 %)&quot; ELSEIF [alloying_total] &lt; 10 THEN &quot;2 Medium (5–10 %)&quot; ELSEIF [alloying_total] &lt; 30 THEN &quot;3 High (10–30 %)&quot; ELSE &quot;4 Very high (&gt;30 %)&quot; END' />
      </column>
      <column caption='CE wieldability' datatype='string' name='[Calculation_1244979895812100]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [family_group] = &quot;Carbon &amp; low-alloy&quot; THEN (IF [carbon_equivalent] &lt;= 0.40 THEN &quot;Readily weldable&quot; ELSEIF [carbon_equivalent] &lt;= 0.60 THEN &quot;Preheat advised&quot; ELSE &quot;Difficult&quot; END) END' />
      </column>
      <column aggregation='None' caption='Measure TS (bin)' datatype='integer' name='[Measure TS (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[Calculation_1244979895422976]' peg='0' size='50' />
      </column>
